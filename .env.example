# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL_ID: Model ID for Gemini SDK (e.g., gemini-2.5-flash, gemini-2.0-flash)
GEMINI_MODEL_ID="gemini-2.5-flash"

# CADESK_AI_MODE: Sidecar operational mode ("mock" or "live")
CADESK_AI_MODE="mock"

# HF_API_KEY: Server-side Hugging Face API key for sidecar (never exposed to browser)
HF_API_KEY=""

# ALLOWED_ORIGINS: Comma-separated CORS origins for FastAPI sidecar
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# APP_URL: Host URL
APP_URL="http://localhost:3000"
